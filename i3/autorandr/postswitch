#!/usr/bin/env bash

# autorandr hook, run after each screen switch (when a screen is plugged / unplugged)
# regenerate the i3 config with the new screens, reload i3, relaunch the polybar (one per screen, a reload
# doesn't run exec_always), then move the open workspaces to their screen (i3 only assigns a screen to the
# new workspaces)

# at login, i3 isn't started yet and the config is generated before it (see the nixos configuration)
i3-msg -t get_version > /dev/null 2>&1 || exit 0

python3 "$HOME/.config/i3/screen_management.py" -e
i3-msg reload
setsid -f "$HOME/.config/polybar/launch.sh" > /dev/null 2>&1
python3 "$HOME/.config/i3/rearrange_workspaces.py"
