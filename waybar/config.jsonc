// waybar (sway bar), linked as ~/.config/waybar by install.sh : the modules of the polybar (i3), same colors (style.css).
// The polybar toggles are drawers : hover the chip icon for the system stats, the clock for the uptime / timer / chronometer.
// The icons are Nerd Font characters written as \u escapes (an editor can silently drop the raw characters).
// Reload after a change : $mod+Shift+c (sway reload)
{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 6,

    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-right": ["mpris", "pulseaudio", "backlight", "battery", "network", "bluetooth", "group/claude", "group/system", "disk#alert", "group/time", "tray", "custom/power"],

    "sway/workspaces": {
        "disable-scroll": true
    },
    "sway/window": {
        "max-length": 60
    },

    "mpris": {
        "player": "spotify",
        "format": " {artist} - {title}",
        "format-paused": " {artist} - {title}",
        "max-length": 45
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-middle": "pavucontrol"
    },
    "backlight": {
        "format": " {percent}%",
        "on-scroll-up": "brightnessctl set +10%",
        "on-scroll-down": "brightnessctl set 10%-"
    },
    "battery": {
        "states": { "warning": 30, "critical": 20 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " {ifname}",
        "format-disconnected": " offline",
        "tooltip-format": "{ifname} {ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "",
        "format-connected": " {device_alias}",
        "format-off": "",
        "format-disabled": "",
        "tooltip-format": "bluetooth {status}",
        "on-click": "blueman-manager"
    },

    "group/system": {
        "orientation": "inherit",
        "drawer": { "transition-duration": 300, "children-class": "drawer-child", "transition-left-to-right": false },
        "modules": ["custom/system", "memory", "cpu", "temperature", "disk"]
    },
    "custom/system": {
        "format": "",
        "tooltip-format": "System : hover to show the memory, CPU, temperature and / disk usage\nClick : Mission Center",
        "on-click": "swaymsg '[app_id=io.missioncenter.MissionCenter] focus' || mission-center"
    },
    // Claude Code : real % of the 5 h block and of the week (as /usage) and the time left before the reset
    // (my_script claude_usage ; falls back to an estimate from the local logs when offline).
    // Drawer : only the icon in the bar, hover for the 5 h %, the week % and the reset (the tooltip has the details)
    "group/claude": {
        "orientation": "inherit",
        "drawer": { "transition-duration": 300, "children-class": "drawer-child", "transition-left-to-right": false },
        "modules": ["custom/claude-short", "custom/claude"]
    },
    "custom/claude-short": {
        "exec": "my_script claude_usage short",
        "return-type": "json",
        "interval": 60,
        "on-click": "kitty --hold my_script claude_usage report"
    },
    "custom/claude": {
        "exec": "my_script claude_usage",
        "return-type": "json",
        "interval": 60,
        "on-click": "kitty --hold my_script claude_usage report"
    },
    "memory": {
        "format": "\udb80\udf5b {percentage}%"
    },
    "cpu": {
        "format": " {usage}%"
    },
    // the / partition (nixos, nix store) : always in the system drawer ...
    "disk": {
        "path": "/",
        "interval": 60,
        "format": "\uf0a0 {percentage_used}%",
        "tooltip-format": "/ : {used} used of {total}, {free} free\nClick : what takes the space (gdu)",
        "on-click": "kitty gdu -x /"
    },
    // ... and in the bar only when it is nearly full (yellow from 80 %, red from 90 %)
    "disk#alert": {
        "path": "/",
        "interval": 60,
        "states": { "warning": 80, "critical": 90 },
        "format": "",
        "format-warning": "\uf0a0 / {percentage_used}%",
        "format-critical": "\uf0a0 / {percentage_used}% full",
        "tooltip-format": "/ : {used} used of {total}, {free} free\nClick : clean up (my_script clean)",
        "on-click": "kitty my_script clean"
    },
    "temperature": {
        "format": " {temperatureC}°C",
        "critical-threshold": 85
    },

    "group/time": {
        "orientation": "inherit",
        "drawer": { "transition-duration": 300, "children-class": "drawer-child", "transition-left-to-right": false },
        "modules": ["custom/clock", "custom/uptime", "custom/timer", "custom/chronometer"]
    },
    // the time ; hover : the date in English and in French, the calendar with today highlighted (waybar/clock.py)
    "custom/clock": {
        "exec": "python3 ~/.config/waybar/clock.py",
        "return-type": "json",
        "interval": 10
    },
    "custom/uptime": {
        "exec": "my_script uptime",
        "interval": 60,
        "format": " {}",
        "tooltip-format": "Time on the computer today : {}\nClick : the sessions of today",
        "on-click": "my_script uptime -display_entry"
    },
    "custom/timer": {
        "exec": "my_script timer watch",
        "format": " {}",
        "tooltip-format": "Countdown : {}\nClick : start / pause, right click : reset, scroll : ±5 s",
        "on-click": "my_script timer toggle",
        "on-click-right": "my_script timer reset",
        "on-scroll-up": "my_script timer add 5",
        "on-scroll-down": "my_script timer add -5"
    },
    "custom/chronometer": {
        "exec": "my_script chronometer watch",
        "format": " {}",
        "tooltip-format": "Stopwatch : {}\nClick : start / pause, right click : reset",
        "on-click": "my_script chronometer toggle",
        "on-click-right": "my_script chronometer reset"
    },

    "tray": {
        "spacing": 8
    },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "my_script logout_menu"
    }
}
