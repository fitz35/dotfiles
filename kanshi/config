# an unknown screen (video projector...) : turned on at the right of the laptop by sway, without any workspace
# (all of them stay on the laptop, move one there by hand with $mod+Alt+4) ; kanshi allows only one * per profile
profile unknown {
    output "HKC OVERSEAS LIMITED 0x3CFE Unknown" mode 1920x1080@59.99Hz position 0,0
    output * enable
    exec python3 ~/.config/i3/screen_management.py --sway "HKC OVERSEAS LIMITED 0x3CFE Unknown"
}
