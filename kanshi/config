# kanshi : the screen profiles of sway (started by sway/config), linked as ~/.config/kanshi by install.sh.
# Converted from the autorandr profiles of i3 (i3/autorandr/, screen.json) : same names, positions, rotation and screen roles.
# A screen is matched by its description "make model serial" (swaymsg -t get_outputs) : the dock screens change names.
# kanshi uses the first profile matching all the connected screens, then its exec gives the workspaces to the screens
# (screen_management.py --sway <main screen> <screen 2> <screen 3>).
# New setup : place the screens (swaymsg output ...), copy a profile with the descriptions of swaymsg -t get_outputs.
# The rotation transform 90 gives the portrait screens of xrandr "left" (checked on the work dock ; 270 was upside down).

profile docked-work-inria {
    output "Hewlett Packard HP E241i CN45090N87" mode 1920x1200@59.95Hz position 1920,0
    output "Dell Inc. DELL U2412M Y1H5T22G3KAL" mode 1920x1200@59.95Hz position 3840,0 transform 90
    output "HKC OVERSEAS LIMITED 0x3CFE Unknown" mode 1920x1080@59.99Hz position 0,0
    exec python3 ~/.config/i3/screen_management.py --sway "Hewlett Packard HP E241i CN45090N87" "Dell Inc. DELL U2412M Y1H5T22G3KAL" "HKC OVERSEAS LIMITED 0x3CFE Unknown"
}

