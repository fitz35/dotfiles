// Zed settings, linked as ~/.config/zed/settings.json by install.sh (the changes made in Zed land in the repo).
// The look of my VS Code, which uses its Linux defaults : 'Droid Sans Mono' (not installed : DejaVu Sans Mono) 14,
// normal weight, line height 1.35, Dark Modern theme, vscode-icons, and the VS Code shortcuts.
// Settings reference : https://zed.dev/docs/configuring-zed
{
  // Claude Code in the agent panel (through ACP, installed from Zed's registry)
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "low",
        "mode": "auto"
      },
      "type": "registry"
    }
  },
  // the explorer : wider than Zed's 240 px (like the VS Code sidebar), its text is the ui_font_size
  "project_panel": {
    "dock": "left",
    "default_width": 300
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "base_keymap": "VSCode",

  // installed automatically at the first start : the theme and icons, then the equivalents of my VS Code extensions
  "auto_install_extensions": {
    "vscode-dark-modern": true,
    "vscode-icons": true,
    "nix": true, // nix-ide
    "svelte": true, // svelte-vscode
    "vue": true, // volar
    "java": true, // java pack (jdtls, debugger)
    "latex": true, // latex-workshop (texlab ; the pdf opens in an external viewer)
    "dockerfile": true, // docker
    "docker-compose": true,
    "rainbow-csv": true, // rainbow-csv
    "ron": true, // vscode-ron
    "xml": true, // vscode-xml
    "neocmake": true, // cmake-tools
    "django": true, // vscode-django
    "git-firefly": true, // git syntax (commit messages, .gitignore...)
    "http": true // http-client
  },
  "theme": "VSCode Dark Modern",
  // clearer separations : the theme's borders (#2B2B2B, the split line at 9 % white) hardly show on its dark
  // backgrounds, so they use #454545 (the VS Code border), and the active pane is framed in the VS Code blue
  "theme_overrides": {
    "VSCode Dark Modern": {
      "border": "#454545",
      "pane_group.border": "#454545",
      "pane.focused_border": "#0078D4"
    }
  },
  "active_pane_modifiers": {
    "border_size": 1.0,
    "inactive_opacity": 1.0
  },
  "icon_theme": "VSCode Icons for Zed (Dark)",

  // editor : DejaVu Sans Mono 14, normal weight, line height 1.35 (the VS Code values on Linux)
  "buffer_font_family": "DejaVu Sans Mono",
  "buffer_font_size": 14,
  "buffer_font_weight": 400,
  "buffer_line_height": { "custom": 1.35 },

  // interface : DejaVu Sans ; its size also sets the height of the bars (status bar at the bottom, tabs, title bar)
  // and the explorer text (Zed has no separate setting for them) ; Zed's default is 16, 13 (VS Code) was too small
  "ui_font_family": "DejaVu Sans",
  "ui_font_size": 18,
  "ui_font_weight": 400,
  // the AI panel : the answers bigger than the rest (DejaVu Sans 20), my messages smaller and monospaced (16),
  // so the answers stand out (Zed has no color setting for the panel alone, it uses the theme colors) ;
  // not applied live : restart Zed (or reopen the thread) after a change
  "agent_ui_font_family": "DejaVu Sans",
  "agent_ui_font_size": 20,
  "agent_buffer_font_family": "DejaVu Sans Mono",
  "agent_buffer_font_size": 16,

  "terminal": {
    "font_family": "DejaVu Sans Mono",
    "font_size": 14
  },

  // syntax colors like VS Code : the language server's semantic tokens (macros, crates, modules, types...) on top
  // of Zed's tree-sitter colors (off by default in Zed : tree-sitter alone can't tell a crate from a variable)
  "semantic_tokens": "combined",

  // inlay hints (types, argument names) everywhere, as in VS Code (off by default in Zed)
  "inlay_hints": {
    "enabled": true
  },

  // formatting : the Zed defaults (format on save, Ruff for Python, which also sorts the imports)

  "lsp": {
    // python : basedpyright (Zed's default, instead of Pylance), with my VS Code Pylance settings ;
    // typeCheckingMode isn't a Zed setting : "basic" goes in the pyrightconfig.json / pyproject.toml of a project
    // ([tool.basedpyright]), Zed's default is "standard" (stricter) ; autoFormatStrings is Pylance only
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "analysis": {
            "diagnosticMode": "workspace",
            "autoImportCompletions": true,
            "inlayHints": {
              "callArgumentNames": true,
              "functionReturnTypes": true,
              "variableTypes": true
            }
          }
        }
      }
    },
    // rust : rust-analyzer from the PATH (the nix shell's, through direnv) is used first, as in VS Code
    "rust-analyzer": {
      "initialization_options": {
        "imports": {
          "granularity": {
            "group": "module"
          }
        }
      }
    }
  }
}
