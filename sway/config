# sway config : the part shared with i3 is ~/.config/i3/common.conf (same syntax), this file has the Wayland specific part.
# Linked as ~/.config/sway by install.sh. Check : sway --validate ; reload : $mod+Shift+c

# ------------------ variables (set here : the ones of an included file aren't visible in this file) ------------------
set $mod Mod4
set $my_script my_script
set $i3_config_folder $HOME/.config/i3
set $term kitty
set $wm_msg swaymsg
# the workspaces of each screen, generated by screen_management.py (after each kanshi profile)
set $screens_conf ~/.config/sway/screens.conf

include ~/.config/i3/common.conf

# nixos : gives the session environment (WAYLAND_DISPLAY...) to the D-Bus services and the portals (dunst, screen sharing)
include /etc/sway/config.d/*

# ------------------ input (in i3 : services.xserver.xkb of the nixos config, numlockx) ------------------
input type:keyboard {
    xkb_layout fr
    xkb_options eurosign:e,caps:escape
    xkb_numlock enabled
}

# ------------------ bar ------------------
bar {
    swaybar_command waybar
}

# ------------------ session ------------------
exec nm-applet --indicator
# password prompt of the GUI apps needing root (polkit agent, installed by nixos)
exec /run/current-system/sw/libexec/polkit-gnome-authentication-agent-1
# clipboard history (my_script clipboard)
exec wl-paste --watch cliphist store
# lock after 2 min without activity, and before sleeping (in i3 : xset + xss-lock)
exec swayidle -w timeout 120 '$my_script lock' before-sleep '$my_script lock'
# screens : sway turns all of them on side by side ; the kanshi profiles (positions, rotation, workspaces)
# come after a first login, from `swaymsg -t get_outputs` (the dock screens have other names than in X)

# screenshot of a zone, copied in the clipboard (in i3 : flameshot)
bindsym $mod+Print exec grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot" "copied in the clipboard"

# move all the workspaces back to their assigned screen
bindsym $mod+Mod1+r exec python3 $i3_config_folder/rearrange_workspaces.py

# reload the configuration file
bindsym $mod+Shift+c reload
# exit sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway ? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# ------------------ native Wayland apps (app_id : the class rules of common.conf only match the X apps) ------------------
# to identify the app_id of a window : swaymsg -t get_tree | grep app_id
assign [app_id="thunderbird"] $ws1
# the calendar reminders of thunderbird are a dialog : tiled (resized), its buttons don't react to the clicks
for_window [app_id="thunderbird" title="(?i)reminder"] floating enable
assign [app_id="firefox"] $ws2
assign [app_id="obsidian"] $ws4
assign [app_id="discord"] $ws5
for_window [app_id="code" title=".* - Visual Studio Code"] move container to workspace $ws3
for_window [app_id="obsidian" title=".*notes*."] move container to workspace $ws4
for_window [app_id="code" title=".*dotfiles - Visual Studio Code"] move container to workspace $ws9
