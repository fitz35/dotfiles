# sway config : the part shared with i3 is ~/.config/i3/common.conf (same syntax), this file has the Wayland specific part.
# Linked as ~/.config/sway by install.sh. Check : sway --validate ; reload : $mod+Shift+c

# ------------------ variables (set here : the ones of an included file aren't visible in this file) ------------------
set $mod Mod4
set $my_script my_script
set $i3_config_folder $HOME/.config/i3
set $term kitty
set $wm_msg swaymsg
# the workspaces of each screen, generated by screen_management.py (after each kanshi profile)
set $screens_conf ~/.config/sway/screens.conf

include ~/.config/i3/common.conf

# nixos : gives the session environment (WAYLAND_DISPLAY...) to the D-Bus services and the portals (dunst, screen sharing)
include /etc/sway/config.d/*

# ------------------ input (in i3 : services.xserver.xkb of the nixos config, numlockx) ------------------
input type:keyboard {
    xkb_layout fr
    xkb_options eurosign:e,caps:escape
    xkb_numlock enabled
}

# tap to click (on in X : the libinput default of nixos, off in sway)
input type:touchpad {
    tap enabled
}

# ------------------ bar ------------------
bar {
    swaybar_command waybar
}

# ------------------ session ------------------
exec nm-applet --indicator
# password prompt of the GUI apps needing root (polkit agent, installed by nixos)
exec /run/current-system/sw/libexec/polkit-gnome-authentication-agent-1
# clipboard history (my_script clipboard)
exec wl-paste --watch cliphist store
# lock after 2 min without activity, and before sleeping (in i3 : xset + xss-lock)
exec swayidle -w timeout 120 '$my_script lock' before-sleep '$my_script lock'
# screens : kanshi applies the profile of the connected screens (~/.config/kanshi/config : positions, rotation,
# then the workspaces of each screen with screen_management.py --sway)
exec kanshi
# a reload resets the screens and the workspaces : re-apply the profile on each one (also a plain `swaymsg reload`)
exec_always kanshictl reload
# the system monitor, on the workspace 16 (assign below)
exec mission-center

# screenshot : flameshot (select, annotate, copy / save), as in i3 ; Print alone : the grim fallback (area to the clipboard)
exec flameshot
bindsym $mod+Print exec flameshot gui
bindsym Print exec grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot" "copied in the clipboard"

# move all the workspaces back to their assigned screen
bindsym $mod+Mod1+r exec python3 $i3_config_folder/rearrange_workspaces.py

# reload the configuration file (the kanshi profile is re-applied by the exec_always above)
bindsym $mod+Shift+c reload
# exit sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway ? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# ------------------ native Wayland apps (app_id : the class rules of common.conf only match the X apps) ------------------
# to identify the app_id of a window : swaymsg -t get_tree | grep app_id
assign [app_id="thunderbird"] $ws1
# the calendar reminders of thunderbird are a dialog : tiled (resized), its buttons don't react to the clicks ;
# brought back from the workspace 1 (assign above) to the screen where I am
for_window [app_id="thunderbird" title="(?i)reminder"] floating enable, move container to output current, focus
assign [app_id="firefox"] $ws2
assign [app_id="md.obsidian.Obsidian"] $ws4
assign [app_id="discord"] $ws5
assign [app_id="spotify"] $ws11
# the system monitor, opened at startup (below) ; the workspace 16 ($mod+F6) is the monitoring one
assign [app_id="io.missioncenter.MissionCenter"] $ws16
for_window [app_id="code" title=".* - Visual Studio Code"] move container to workspace $ws3
for_window [app_id="md.obsidian.Obsidian" title=".*notes*."] move container to workspace $ws4
for_window [app_id="code" title=".*dotfiles - Visual Studio Code"] move container to workspace $ws9
# zed on the workspace 3, except the dotfiles window (workspace 9, opened at login) ; each rule runs once per window,
# so a zed window moved by hand stays where it is
for_window [app_id="dev.zed.Zed"] move container to workspace $ws3
for_window [app_id="dev.zed.Zed" title="^dotfiles( — .*)?$"] move container to workspace $ws9
# flameshot : its capture overlay floats over all the screens (global : the grim image spans every output,
# fullscreen on one output only shows its top-left corner there) ; flameshot 13 sets no app_id, only the title
for_window [title="^flameshot$"] floating enable, fullscreen enable global
